[Unit]
Description=Order-incapable Polymarket public wallet paper observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copybot-paper
Group=copybot-paper
WorkingDirectory=/opt/copybot-paper
ExecStart=/usr/bin/python3 /opt/copybot-paper/observe_wallets.py --roster /var/lib/copybot-paper/roster.json --state /var/lib/copybot-paper/state-fast-v1.json --output /var/lib/copybot-paper/observations-fast-v1.jsonl --poll-seconds 0.5 --delay-ms 0 --max-polls 0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/copybot-paper
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=700M

[Install]
WantedBy=multi-user.target
