[Unit]
Description=Order-incapable Polygon mempool wallet observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copybot-paper
Group=copybot-paper
WorkingDirectory=/opt/copybot-paper
ExecStart=/opt/copybot-paper/copybot-mempool-observer --roster /var/lib/copybot-paper/roster.json --output /var/lib/copybot-paper/mempool-observations.jsonl --feed wss://polygon-bor-rpc.publicnode.com --max-seconds 0
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/copybot-paper
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M

[Install]
WantedBy=multi-user.target
